{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'partner.index.title'|trans }} · {{ 'app.name'|trans }}{% endblock %}

{% block admin_content %}
    <twig:Page:Header :title="'partner.index.title'|trans" :subtitle="'partner.index.subtitle'|trans" style="margin-bottom: var(--itk-space-5);">
        <a href="{{ path('admin_partner_new') }}" class="btn btn--primary">{{ 'action.new'|trans }}</a>
    </twig:Page:Header>

    <div class="card">
        {% if rows is empty %}
            <twig:EmptyState :title="'partner.empty.title'|trans" :hint="'partner.empty.hint'|trans" />
        {% else %}
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>{{ 'partner.name'|trans }}</th>
                            <th>{{ 'partner.website'|trans }}</th>
                            <th>{{ 'partner.usage'|trans }}</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            {% set partner = row.partner %}
                            <tr>
                                <td class="cell-title">{{ partner.name }}</td>
                                <td>{% if partner.website %}<a href="{{ partner.website }}" target="_blank" rel="noopener">{{ partner.website }}</a>{% else %}—{% endif %}</td>
                                <td>{% if row.projects is empty %}<span class="muted">{{ 'partner.usage_none'|trans }}</span>{% else %}{{ 'partner.usage_count'|trans({'%count%': row.projects|length}) }}{% endif %}</td>
                                <td>
                                    <div class="cell-actions">
                                        <a href="{{ path('admin_partner_edit', {id: partner.id}) }}" class="btn btn--ghost btn--sm">{{ 'action.edit'|trans }}</a>
                                        {{ include('admin/partners/_delete.html.twig', {partner: partner, projects: row.projects, small: true}) }}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
