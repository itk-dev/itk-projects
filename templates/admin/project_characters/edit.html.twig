{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'project_character.edit.title'|trans }} · {{ 'app.name'|trans }}{% endblock %}

{% block admin_content %}
    <twig:Page:Header :title="character.name" style="margin-bottom: var(--itk-space-5);">
        <twig:block name="breadcrumb">
            <div class="breadcrumb"><a href="{{ path('admin_project_characters') }}">{{ 'nav.project_characters'|trans }}</a></div>
        </twig:block>
        <twig:ConfirmDelete
            :action="path('admin_project_character_delete', {id: character.id})"
            :token="csrf_token('delete-project-character-' ~ character.id)"
            :title="'action.confirm_delete_title'|trans({'%name%': character.name})" />
    </twig:Page:Header>
    {{ include('admin/project_characters/_form.html.twig', {button_label: 'action.save'}) }}
{% endblock %}
