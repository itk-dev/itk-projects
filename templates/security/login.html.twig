{% extends 'base.html.twig' %}

{% block title %}{{ 'login.title'|trans }} · {{ 'app.name'|trans }}{% endblock %}

{% block body %}
    <div class="auth">
        <div class="auth__card">
            <div class="auth__brand">
                <img class="auth__logo" src="{{ asset('images/itk-logo.png') }}" alt="ITK">
                <span>{{ 'app.name'|trans }}</span>
            </div>
            <h1 class="auth__title">{{ 'login.title'|trans }}</h1>

            {% if error %}
                <div class="flash flash--error" style="position: static; box-shadow: none; margin-bottom: var(--itk-space-4);">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {# A full page load after login: the feedback widget only initialises on
               one, and Turbo carries it over to later visits from there. #}
            <form method="post" data-turbo="false">
                <div class="form-row">
                    <label for="username">{{ 'login.email'|trans }}</label>
                    <input type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus>
                </div>
                <div class="form-row">
                    <label for="password">{{ 'login.password'|trans }}</label>
                    <input type="password" id="password" name="_password" autocomplete="current-password" required>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button type="submit" class="btn btn--primary btn--block">{{ 'login.submit'|trans }}</button>
            </form>
        </div>
    </div>
{% endblock %}
