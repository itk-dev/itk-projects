{% import _self as h %}

{% macro sortlink(field, label, sort, direction) %}
    {% set isActive = sort == field %}
    {% set newDir = (isActive and direction == 'ASC') ? 'DESC' : 'ASC' %}
    <a class="table__sort {{ isActive ? 'is-active' }}" href="{{ path('app_project_index', app.request.query.all|merge({sort: field, direction: newDir, page: 1})) }}">
        {{ label|trans }}{% if isActive %} {{ direction == 'ASC' ? '▲' : '▼' }}{% endif %}
    </a>
{% endmacro %}

{% macro icon(name) %}
    {% if name == 'eye' %}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
    {% elseif name == 'edit' %}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
    {% elseif name == 'trash' %}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
    {% endif %}
{% endmacro %}

{% if pagination.items is empty %}
    <twig:EmptyState :title="'project.empty.title'|trans" :hint="'project.empty.hint'|trans" />
{% else %}
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>{{ h.sortlink('title', 'project.title', sort, direction) }}</th>
                    <th>{{ 'project.status'|trans }}</th>
                    <th>{{ 'project.project_type'|trans }}</th>
                    <th>{{ 'project.organizational_anchoring'|trans }}</th>
                    <th>{{ h.sortlink('timePeriodStart', 'project.time_period', sort, direction) }}</th>
                    <th>{{ 'project.author'|trans }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for project in pagination.items %}
                    <tr>
                        <td>
                            <a href="{{ path('app_project_show', {id: project.id}) }}" class="cell-title" data-turbo-frame="_top">{{ project.title }}</a>
                        </td>
                        <td>
                            {% if project.status %}
                                <span class="badge badge--status-{{ project.status.value }}">{{ project.status.labelKey|trans }}</span>
                            {% else %}
                                <span class="muted">—</span>
                            {% endif %}
                        </td>
                        <td>{{ project.projectType ? project.projectType.labelKey|trans : '—' }}</td>
                        <td>{{ project.organizationalAnchoring ? project.organizationalAnchoring.name : '—' }}</td>
                        <td>
                            {% if project.timePeriodStart %}
                                {{ project.timePeriodStart|date('d.m.Y') }}{% if project.timePeriodEnd %} – {{ project.timePeriodEnd|date('d.m.Y') }}{% endif %}
                            {% else %}—{% endif %}
                        </td>
                        <td>{{ project.createdBy ? project.createdBy.name : '—' }}</td>
                        <td>
                            <div class="cell-actions">
                                <a href="{{ path('app_project_show', {id: project.id}) }}" class="btn-icon" data-turbo-frame="_top" title="{{ 'action.view'|trans }}" aria-label="{{ 'action.view'|trans }}">{{ h.icon('eye') }}</a>
                                <a href="{{ path('app_project_edit', {id: project.id}) }}" class="btn-icon" data-turbo-frame="_top" title="{{ 'action.edit'|trans }}" aria-label="{{ 'action.edit'|trans }}">{{ h.icon('edit') }}</a>
                                {% set trashIcon %}{{ h.icon('trash') }}{% endset %}
                                <twig:ConfirmDelete
                                    :action="path('app_project_delete', {id: project.id})"
                                    :token="csrf_token('delete-project-' ~ project.id)"
                                    :title="'action.confirm_delete_title'|trans({'%name%': project.title})"
                                    triggerClass="btn-icon btn-icon--danger"
                                    :triggerTitle="'action.delete'|trans"
                                    :triggerContent="trashIcon"
                                    frame="_top" />
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="pagination">
        <span class="pagination__info">{{ pagination.firstResult }}–{{ pagination.lastResult }} / {{ pagination.total }}</span>
        {% if pagination.pages > 1 %}
            <div class="pagination__pages">
                {% if pagination.hasPrevious %}
                    <a class="pagination__link" href="{{ path('app_project_index', app.request.query.all|merge({page: pagination.page - 1})) }}">‹</a>
                {% endif %}
                {% for p in 1..pagination.pages %}
                    {% if pagination.pages <= 12 or (p <= 2) or (p >= pagination.pages - 1) or (p >= pagination.page - 2 and p <= pagination.page + 2) %}
                        <a class="pagination__link {{ p == pagination.page ? 'is-active' }}" href="{{ path('app_project_index', app.request.query.all|merge({page: p})) }}">{{ p }}</a>
                    {% endif %}
                {% endfor %}
                {% if pagination.hasNext %}
                    <a class="pagination__link" href="{{ path('app_project_index', app.request.query.all|merge({page: pagination.page + 1})) }}">›</a>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endif %}
