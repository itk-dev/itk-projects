{% extends 'base.html.twig' %}

{% block title %}{{ 'dashboard.title'|trans }} · {{ 'app.name'|trans }}{% endblock %}

{% block body %}
    <div class="page" data-controller="dashboard-live dashboard-viz" data-dashboard-viz-empty-value="{{ 'dashboard.themes_heatmap_empty'|trans }}">
        <twig:Page:Header :title="'dashboard.title'|trans">
            <a href="{{ path('app_project_new') }}" class="btn btn--primary">{{ 'action.new_project'|trans }}</a>
        </twig:Page:Header>

        {{ turbo_stream_from('activities') }}
        <script type="application/json" id="dashboard-viz-data" data-dashboard-viz-target="source">{{ include('dashboard/_viz_json.html.twig') }}</script>

        <div id="dashboard-content">
        <div id="dashboard-stats" class="stat-grid">
            {{ include('dashboard/_stats.html.twig') }}
        </div>

        <div class="viz-grid">
            <div class="card span-6">
                <twig:Card:Header :title="'dashboard.unfinished.title'|trans" :sub="'dashboard.unfinished.sub'|trans" />
                <div class="feed-scroll">
                    {% if unfinishedProjects is empty and incompleteContacts is empty %}
                        <div class="todo-empty">
                            <div class="todo-empty__title">{{ 'dashboard.unfinished.empty_title'|trans }}</div>
                        </div>
                    {% else %}
                        {% for project in unfinishedProjects %}
                            <a class="recent-item" href="{{ path('app_project_edit', {id: project.id}) }}">
                                <span class="recent-item__body">
                                    <span class="recent-item__title">{{ project.title }}</span>
                                    <span class="recent-item__meta">{{ 'dashboard.unfinished.project'|trans }}</span>
                                </span>
                                <span class="badge">{{ 'dashboard.unfinished.percent_done'|trans({'%percent%': project.completionPercentage}) }}</span>
                                <span class="recent-item__cta">{{ 'dashboard.unfinished.cta'|trans }} →</span>
                            </a>
                        {% endfor %}
                        {% for contact in incompleteContacts %}
                            <a class="recent-item" href="{{ path('admin_contact_edit', {id: contact.id}) }}">
                                <span class="recent-item__body">
                                    <span class="recent-item__title">{{ contact.name }}</span>
                                    <span class="recent-item__meta">{{ 'dashboard.unfinished.contact'|trans }}</span>
                                </span>
                                <span class="badge badge--draft">{{ 'dashboard.unfinished.contact_badge'|trans }}</span>
                                <span class="recent-item__cta">{{ 'dashboard.unfinished.cta'|trans }} →</span>
                            </a>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>

            <div class="card span-6 card--stretch">
                <twig:Card:Header :title="'activity.title'|trans" :sub="'activity.subtitle'|trans" />
                <div class="feed-fill">
                    <div id="activity-feed" class="activity-feed feed-scroll">
                        {% if recent is empty %}
                            <div class="todo-empty">
                                <div class="todo-empty__title">{{ 'activity.empty'|trans }}</div>
                            </div>
                        {% else %}
                            {% for project in recent %}
                                {% set updated = project.wasUpdatedAfterCreation %}
                                {% set actor = updated ? project.modifiedBy : project.createdBy %}
                                {{ include('activity/_item.html.twig', {
                                    id: project.id,
                                    action: updated ? 'updated' : 'created',
                                    title: project.title,
                                    url: path('app_project_show', {id: project.id}),
                                    actor: actor ? actor.name : null,
                                    at: updated ? project.updatedAt : project.createdAt,
                                }) }}
                            {% endfor %}
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="card span-12">
                <twig:Card:Header :title="'dashboard.themes_heatmap'|trans" :sub="'dashboard.themes_heatmap_sub'|trans" />
                <div class="card__body">
                    <div class="heat-scroll"><div class="heat" data-dashboard-viz-target="heatmap"></div></div>
                </div>
            </div>

            <div class="card span-12">
                <twig:Card:Header :title="'dashboard.collaboration'|trans" :sub="'dashboard.collaboration_sub'|trans" />
                <div class="card__body">
                    <div class="collab" data-dashboard-viz-target="collab"></div>
                </div>
            </div>

            <div class="card span-7">
                <twig:Card:Header :title="'dashboard.status_by_dept'|trans" :sub="'dashboard.status_by_dept_sub'|trans" />
                <div class="card__body"><div class="chart-box h-320"><canvas data-dashboard-viz-target="statusByDept"></canvas></div></div>
            </div>

            <div class="card span-5">
                <twig:Card:Header :title="'dashboard.by_status'|trans" :sub="'dashboard.by_status_sub'|trans" />
                <div class="card__body"><div class="chart-box h-300"><canvas data-dashboard-viz-target="statusDist"></canvas></div></div>
            </div>

            <div class="card span-5">
                <twig:Card:Header :title="'dashboard.funding_sources'|trans" :sub="'dashboard.funding_sources_sub'|trans" />
                <div class="card__body"><div class="chart-box h-300"><canvas data-dashboard-viz-target="funding"></canvas></div></div>
            </div>

            <div class="card span-7">
                <twig:Card:Header :title="'dashboard.budget_by_dept'|trans" :sub="'dashboard.budget_by_dept_sub'|trans" />
                <div class="card__body"><div class="chart-box h-300"><canvas data-dashboard-viz-target="budget"></canvas></div></div>
            </div>

            <div class="card span-7">
                <twig:Card:Header :title="'dashboard.timeline'|trans" :sub="'dashboard.timeline_sub'|trans" />
                <div class="card__body"><div class="chart-box h-320"><canvas data-dashboard-viz-target="timeline"></canvas></div></div>
            </div>

            <div class="card span-5">
                <twig:Card:Header :title="'dashboard.reach'|trans" :sub="'dashboard.reach_sub'|trans" />
                <div class="card__body"><div class="chart-box h-320"><canvas data-dashboard-viz-target="reach"></canvas></div></div>
            </div>
        </div>
        </div>
    </div>
{% endblock %}
