{% use 'form_div_layout.html.twig' %}

{% block form_label_content %}
    {%- if completion_field|default(false) -%}
        <span class="completion-star" aria-hidden="true" title="{{ 'project.completion_field_hint'|trans }}">★</span>
    {%- endif -%}
    {{- parent() -}}
    {#- A curated pool (areas, types, departments) is marked with a lock that
        links to the administrators who maintain it. -#}
    {%- if curated_url|default(false) -%}
        <a class="curated-mark" href="{{ curated_url }}" title="{{ 'form.curated_hint'|trans }}" aria-label="{{ 'form.curated_hint'|trans }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        </a>
    {%- endif -%}
{% endblock %}

{% block form_row %}
    {% set row_class = 'form-row' %}
    <div class="{{ row_class }}">
        <div class="form-row__head">
            {{ form_label(form) }}
            {%- if help is not empty -%}
                <div class="form-help">{{ help|trans(help_translation_parameters, translation_domain) }}</div>
            {%- endif -%}
        </div>
        {#- aria-invalid lets the stylesheet outline the field, and is what the
            autosave controller sets when it marks a field from a 422 response. -#}
        {{ form_widget(form, errors|length > 0 ? {attr: attr|merge({'aria-invalid': 'true'})} : {}) }}
        {{ form_errors(form) }}
    </div>
{% endblock %}

{% block checkbox_row %}
    <div class="form-row">
        <div class="checkbox-row">
            {{ form_widget(form) }}
            {{ form_label(form) }}
        </div>
        {{ form_errors(form) }}
        {%- if help is not empty -%}
            <div class="form-help">{{ help|trans(help_translation_parameters, translation_domain) }}</div>
        {%- endif -%}
    </div>
{% endblock %}

{% block choice_widget_expanded %}
    <div {{ block('widget_container_attributes') }} class="choice-expanded">
        {%- for child in form -%}
            <label>
                {{ form_widget(child) }}
                {{ child.vars.label|trans }}
            </label>
        {%- endfor -%}
    </div>
{% endblock %}

{# One relevant-link row: url and note side by side, with no per-row labels.
   Rendering it here keeps the collection's prototype and its saved rows identical. #}
{% block project_link_widget %}
    <div class="link-fields">
        {{ form_widget(form.url) }}
        {{ form_widget(form.note) }}
    </div>
    {{ form_errors(form.url) }}
    {{ form_errors(form.note) }}
{% endblock %}

{% block form_errors %}
    {%- if errors|length > 0 -%}
        <ul class="form-errors">
            {%- for error in errors -%}
                <li>{{ error.message }}</li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{% endblock %}
