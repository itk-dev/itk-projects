{% use 'form_div_layout.html.twig' %}

{% block form_label_content %}
    {%- if completion_field|default(false) -%}
        <span class="completion-star" aria-hidden="true" title="{{ 'project.completion_field_hint'|trans }}">★</span>
    {%- endif -%}
    {{- parent() -}}
{% endblock %}

{% block form_row %}
    {% set row_class = 'form-row' %}
    <div class="{{ row_class }}">
        <div class="form-row__head">
            {{ form_label(form) }}
            {%- if help is not empty -%}
                <div class="form-help">{{ help|trans(help_translation_parameters, translation_domain) }}</div>
            {%- endif -%}
        </div>
        {{ form_widget(form) }}
        {{ form_errors(form) }}
    </div>
{% endblock %}

{% block checkbox_row %}
    <div class="form-row">
        <div class="checkbox-row">
            {{ form_widget(form) }}
            {{ form_label(form) }}
        </div>
        {{ form_errors(form) }}
        {%- if help is not empty -%}
            <div class="form-help">{{ help|trans(help_translation_parameters, translation_domain) }}</div>
        {%- endif -%}
    </div>
{% endblock %}

{% block choice_widget_expanded %}
    <div {{ block('widget_container_attributes') }} class="choice-expanded">
        {%- for child in form -%}
            <label>
                {{ form_widget(child) }}
                {{ child.vars.label|trans }}
            </label>
        {%- endfor -%}
    </div>
{% endblock %}

{% block form_errors %}
    {%- if errors|length > 0 -%}
        <ul class="form-errors">
            {%- for error in errors -%}
                <li>{{ error.message }}</li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{% endblock %}

{% block file_widget %}
    <div class="upload-field" data-controller="file-field" data-action="change->file-field#picked">
        <label class="upload-field__drop" data-file-field-target="drop">
            <svg class="upload-field__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 16V4m0 0L7 9m5-5l5 5"/>
                <path d="M5 20h14"/>
            </svg>
            <span class="upload-field__cta">{{ 'media.choose'|trans }}</span>
            <span class="upload-field__filename" data-file-field-target="filename"></span>
            {{- block('form_widget_simple') -}}
        </label>
        <div class="upload-field__progress" data-file-field-target="progress" hidden>
            <div class="upload-field__bar" data-file-field-target="bar"></div>
        </div>
    </div>
{% endblock %}
