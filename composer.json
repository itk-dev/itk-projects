{
    "name": "itk-dev/itk-projects",
    "description": "Symfony app for registering and browsing municipal projects.",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^3.3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0.1",
        "doctrine/orm": "^3.7.4",
        "itk-dev/entity-bundle": "^0.1",
        "itk-dev/tidy-feedback": "^1.0",
        "league/csv": "^9.28",
        "symfony/asset": "~8.1.0",
        "symfony/asset-mapper": "~8.1.8",
        "symfony/console": "~8.1.8",
        "symfony/dotenv": "~8.1.6",
        "symfony/flex": "^2",
        "symfony/form": "~8.1.8",
        "symfony/framework-bundle": "~8.1.8",
        "symfony/mercure-bundle": "^0.4.3",
        "symfony/rate-limiter": "~8.1.6",
        "symfony/runtime": "~8.1.0",
        "symfony/security-bundle": "~8.1.8",
        "symfony/translation": "~8.1.5",
        "symfony/twig-bundle": "~8.1.7",
        "symfony/ux-turbo": "^3.5.1",
        "symfony/ux-twig-component": "^3.5.1",
        "symfony/validator": "~8.1.8",
        "symfony/yaml": "~8.1.8",
        "twig/extra-bundle": "^2.12 || ^3.29",
        "twig/twig": "^2.12 || ^3.30"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "ergebnis/composer-normalize": "^2.54",
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-doctrine": "^2.0.28",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4.1",
        "rregeer/phpunit-coverage-check": "^0.3.1",
        "symfony/browser-kit": "~8.1.5",
        "symfony/css-selector": "~8.1.6",
        "symfony/debug-bundle": "~8.1.0",
        "symfony/maker-bundle": "^1.68",
        "symfony/web-profiler-bundle": "~8.1.8",
        "vincentlanglet/twig-cs-fixer": "^4.1.1",
        "zenstruck/foundry": "^2.14"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "repositories": [
        {
            "name": "entity-bundle",
            "type": "vcs",
            "url": "https://github.com/itk-dev/entity-bundle.git"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": "true",
            "require": "8.1.*"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "test": "vendor/bin/phpunit",
        "test-coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "vendor/bin/phpunit --coverage-clover=coverage/clover.xml",
            "vendor/bin/coverage-check coverage/clover.xml 100"
        ],
        "test-setup": [
            "@php bin/console doctrine:database:drop --force --if-exists --env=test",
            "@php bin/console doctrine:database:create --if-not-exists --env=test",
            "@php bin/console doctrine:migrations:migrate --no-interaction --env=test",
            "@php bin/console doctrine:fixtures:load --no-interaction --env=test"
        ]
    }
}
